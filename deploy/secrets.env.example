# psina environment for deploy/compose.yaml (copy to secrets.env).
# Names map PSINA_<SECTION>_<KEY> to <section>.<key>: multi-word keys stay
# unbroken (PRIVATEKEYPATH, not PRIVATE_KEY_PATH). Full list: README "Configuration".
# Commented values are the defaults.

# Database (empty = in-memory store)
PSINA_DB_URL=postgres://psina:password@postgres:5432/psina?sslmode=disable
# PSINA_DB_TABLEPREFIX=

# Server
# PSINA_SERVER_PORT=8080

# Logging
# PSINA_LOGGER_LEVEL=info   # debug, info, warn, error
# PSINA_LOGGER_FORMAT=json  # json, text

# JWT signing key — unset = ephemeral key, every restart logs everyone out.
# openssl genrsa -out jwt.key 2048
# PSINA_JWT_PRIVATEKEYPATH=/secrets/jwt.key
# PSINA_JWT_PRIVATEKEY=     # PEM inline, alternative to the path
# PSINA_JWT_ALGORITHM=RS256 # RS256, ES256

# Refresh rotation
# PSINA_TOKEN_REFRESHREUSELEEWAY=10s  # 0s = strict reuse detection

# Cookies (browser clients)
# PSINA_COOKIE_ENABLED=false
# PSINA_COOKIE_DOMAIN=      # required when enabled
# PSINA_COOKIE_SECURE=true
# PSINA_COOKIE_SAMESITE=strict
# PSINA_COOKIE_PATH=/

# Personal access tokens
# PSINA_PAT_ENABLED=true
# PSINA_PAT_MAXPERUSER=50   # -1 = unlimited
# PSINA_PAT_MAXTTL=0s       # 0s = unlimited
# PSINA_PAT_TOUCHINTERVAL=1m

# OAuth sign-in — a provider is enabled by its client id; all three are required together
# PSINA_OAUTH_AUTOLINKEMAIL=true
# PSINA_OAUTH_GOOGLE_CLIENTID=
# PSINA_OAUTH_GOOGLE_CLIENTSECRET=
# PSINA_OAUTH_GOOGLE_REDIRECTURIS=   # comma-separated, exact match
# PSINA_OAUTH_GITHUB_CLIENTID=
# PSINA_OAUTH_GITHUB_CLIENTSECRET=
# PSINA_OAUTH_GITHUB_REDIRECTURIS=
